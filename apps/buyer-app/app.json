{
  "expo": {
    "name": "Gekel Finds",
    "slug": "buyer-app",
    "scheme": "gekelfinds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gekelfinds.buyer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FA3504",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gekelfinds.buyer",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "bc76849c-26d4-4d57-8dda-964a1b80ff56"
      }
    }
  }
}