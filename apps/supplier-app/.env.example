# Leave EXPO_PUBLIC_API_URL empty to run against the built-in mock backend (demo data, OTP code 123456).
# Set it to your Go API base URL to use the real backend, e.g. http://192.168.1.20:8080/v1
EXPO_PUBLIC_API_URL=
# Support WhatsApp number in international format, no plus sign.
EXPO_PUBLIC_SUPPORT_WHATSAPP=254700123456
