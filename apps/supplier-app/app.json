{
  "expo": {
    "name": "GEKEL Supplier",
    "slug": "gekel-supplier",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gekel",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.gekel.supplier",
      "infoPlist": {
        "NSCameraUsageDescription": "GEKEL uses the camera for product and packing proof photos.",
        "NSPhotoLibraryUsageDescription": "GEKEL lets you pick product photos from your library."
      }
    },
    "android": {
      "package": "co.gekel.seller",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FA3504"
      },
      "permissions": [
        "CAMERA"
      ]
    },
        "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GEKEL to access your photos for product images.",
          "cameraPermission": "Allow GEKEL to use the camera for product and packing proof photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#FA3504"
        }
      ]
    ]
  }
}
